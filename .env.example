# Local development (default)
COMPOSE_FILE=docker-compose.yml
COMPOSE_PROJECT_NAME=wp-sitename

# Production (set this on the server)
# COMPOSE_FILE=docker-compose.yml:docker-compose.production.yml
# MYSQL_ROOT_PASSWORD=<generate-a-strong-password>

# MYSQL_ROOT_PASSWORD is deliberately not set for local development: ./dev.sh up (dev.bat up)
# generates one into .env on first run. scripts/setup-server.sh writes production's. Never commit it.

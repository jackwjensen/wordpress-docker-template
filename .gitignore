# Claude Code: the engineering-standards rules and shared settings are tracked; local
# settings (permissions) are not. !.claude/ re-includes the directory in case a global
# gitignore excludes it — git cannot re-include a file whose parent is excluded.
!.claude/
.claude/*
!.claude/settings.json
!.claude/rules/

# Environment
.env

# WordPress uploads (synced separately, not in git)
wp-content/uploads/*
!wp-content/uploads/.gitkeep

# OS files
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.swp
*.swo

# Database dumps (keep local, don't commit)
backups/
*.sql
*.sql.gz

# Docker volumes
mysql-data/

# WordPress debug log
wp-content/debug.log

# Node (if using build tools in themes)
node_modules/

# MSYS/Git Bash path-conversion ghost dirs (Windows safety net)
*;C/
